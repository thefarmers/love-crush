{
  "name": "love-crush",
  "private": true,
  "version": "1.0.0",
  "description": "A match-3 love letter: fork it, add your names and photos, and they refill hearts by saying \"I love you\".",
  "license": "MIT",
  "keywords": [
    "match-3",
    "game",
    "love",
    "gift",
    "pwa",
    "web-audio",
    "canvas",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "calibrate": "node scripts/calibrate.mjs",
    "check": "tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
